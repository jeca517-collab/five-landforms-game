      p1Index: 0,
      p2Index: 0,
      p1Score: 0,
      p2Score: 0,
      p1Locked: false,
      p2Locked: false,
      ropePos: 0,       // Current smoothed offset
      targetRope: 0,    // Target pull offset (-100 to +100)
      animTime: 0,
      particles: [],
      p1State: 'idle',  // 'idle', 'pull', 'sweat', 'win'
      p2State: 'idle',
      isOver: false
    };

    function addParticles(x, y, color) {
      for (let i = 0; i < 14; i++) {
        gameState.particles.push({
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * 6,
          vy: (Math.random() - 0.7) * 6,
          radius: Math.random() * 3 + 2,
          color: color,
          alpha: 1,
          life: 30
        });
      }
    }

    const tugCanvas = document.getElementById('tugCanvas');
    const tCtx = tugCanvas.getContext('2d');

    function resizeCanvas(c, ctx) {
      const rect = c.getBoundingClientRect();
      c.width = rect.width * window.devicePixelRatio;
      c.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    function drawCuteBear(ctx, x, y, state) {
      ctx.save();
      ctx.translate(x, y);
      let lean = 0;
      let bob = Math.sin(gameState.animTime * 6) * 1.5;
      if (state === 'pull') lean = -12;
      if (state === 'sweat') lean = 6;
      ctx.rotate((lean * Math.PI) / 180);

      // Bear body
      ctx.fillStyle = "#8D5B4C";
      ctx.beginPath();
      ctx.ellipse(0, 10 + bob, 16, 18, 0, 0, Math.PI * 2);
      ctx.fill();

      // Belly
      ctx.fillStyle = "#D7B19D";
      ctx.beginPath();
      ctx.ellipse(0, 12 + bob, 9, 11, 0, 0, Math.PI * 2);
      ctx.fill();

      // Head
      ctx.fillStyle = "#8D5B4C";
      ctx.beginPath();
      ctx.arc(0, -9 + bob, 15, 0, Math.PI * 2);
      ctx.fill();

      // Ears
      ctx.beginPath();
      ctx.arc(-12, -22 + bob, 6, 0, Math.PI * 2);
      ctx.arc(12, -22 + bob, 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#D7B19D";
      ctx.beginPath();
      ctx.arc(-12, -22 + bob, 3, 0, Math.PI * 2);
      ctx.arc(12, -22 + bob, 3, 0, Math.PI * 2);
      ctx.fill();

      // Snout
      ctx.fillStyle = "#D7B19D";
      ctx.beginPath();
      ctx.ellipse(0, -6 + bob, 7, 5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#3E2723";
      ctx.beginPath();
      ctx.arc(0, -8 + bob, 2.5, 0, Math.PI * 2);
      ctx.fill();

      // Eyes
      ctx.fillStyle = "#2D1E18";
      ctx.beginPath();
      ctx.arc(-5, -11 + bob, 2, 0, Math.PI * 2);
      ctx.arc(5, -11 + bob, 2, 0, Math.PI * 2);
      ctx.fill();

      // Blue Team Bandana
      ctx.fillStyle = "#2563EB";
      ctx.beginPath();
      ctx.roundRect(-12, -20 + bob, 24, 4.5, 2);
      ctx.fill();

      // Hands on rope
      ctx.fillStyle = "#8D5B4C";
      ctx.beginPath();
      ctx.arc(10, 8 + bob, 4.5, 0, Math.PI * 2);
      ctx.arc(18, 8 + bob, 4.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function drawCuteRabbit(ctx, x, y, state) {
      ctx.save();
      ctx.translate(x, y);
      let lean = 0;
      let bob = Math.sin(gameState.animTime * 6 + 1) * 1.5;
      if (state === 'pull') lean = 12;
      if (state === 'sweat') lean = -6;
      ctx.rotate((lean * Math.PI) / 180);

      // Ears
      ctx.fillStyle = "#FFFFFF";
      ctx.beginPath();
      ctx.ellipse(-6, -26 + bob, 5, 14, -0.1, 0, Math.PI * 2);
      ctx.ellipse(6, -26 + bob, 5, 14, 0.1, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#FDA4AF";
      ctx.beginPath();
      ctx.ellipse(-6, -26 + bob, 2.5, 9, -0.1, 0, Math.PI * 2);
      ctx.ellipse(6, -26 + bob, 2.5, 9, 0.1, 0, Math.PI * 2);
      ctx.fill();

      // Body
      ctx.fillStyle = "#FFFFFF";
      ctx.beginPath();
      ctx.ellipse(0, 11 + bob, 15, 17, 0, 0, Math.PI * 2);
      ctx.fill();

      // Head
      ctx.fillStyle = "#FFFFFF";
      ctx.beginPath();
      ctx.arc(0, -8 + bob, 14, 0, Math.PI * 2);
      ctx.fill();

      // Cheeks
      ctx.fillStyle = "rgba(251, 113, 133, 0.4)";
      ctx.beginPath();
      ctx.arc(-8, -4 + bob, 3, 0, Math.PI * 2);
      ctx.arc(8, -4 + bob, 3, 0, Math.PI * 2);
      ctx.fill();

      // Nose & Eyes
      ctx.fillStyle = "#E11D48";
      ctx.beginPath();
      ctx.arc(0, -6 + bob, 2, 0, Math.PI * 2);
      ctx.arc(-4, -10 + bob, 2, 0, Math.PI * 2);
      ctx.arc(4, -10 + bob, 2, 0, Math.PI * 2);
      ctx.fill();

      // Red Team Bandana
      ctx.fillStyle = "#E11D48";
      ctx.beginPath();
      ctx.roundRect(-11, -17 + bob, 22, 4.5, 2);
      ctx.fill();

      // Hands on rope
      ctx.fillStyle = "#FFFFFF";
      ctx.beginPath();
      ctx.arc(-10, 8 + bob, 4.5, 0, Math.PI * 2);
      ctx.arc(-18, 8 + bob, 4.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function renderTugLoop() {
      const w = tugCanvas.clientWidth;
      const h = tugCanvas.clientHeight;
      tCtx.clearRect(0, 0, w, h);

      gameState.animTime += 0.04;
      gameState.ropePos += (gameState.targetRope - gameState.ropePos) * 0.1;

      const groundY = h * 0.76;
      const centerX = w / 2;
      const currentRopeX = centerX + gameState.ropePos;

      // Draw Center Danger Lines
      tCtx.strokeStyle = "rgba(245, 158, 11, 0.4)";
      tCtx.setLineDash([4, 4]);
      tCtx.lineWidth = 2;
      tCtx.beginPath();
      tCtx.moveTo(centerX, 4);
      tCtx.lineTo(centerX, groundY + 8);
      tCtx.stroke();
      tCtx.setLineDash([]);

      // Positions of animals
      const p1AnchorX = Math.max(35, centerX - 110 + gameState.ropePos * 0.5);
      const p2AnchorX = Math.min(w - 35, centerX + 110 + gameState.ropePos * 0.5);
      const ropeY = groundY - 6;

      // Draw Rope
      tCtx.beginPath();
      tCtx.moveTo(p1AnchorX - 15, ropeY);
      tCtx.quadraticCurveTo((p1AnchorX + currentRopeX) / 2, ropeY + 3, currentRopeX, ropeY);
      tCtx.quadraticCurveTo((currentRopeX + p2AnchorX) / 2, ropeY + 3, p2AnchorX + 15, ropeY);
      tCtx.strokeStyle = "#92400e";
      tCtx.lineWidth = 6;
      tCtx.lineCap = "round";
      tCtx.stroke();

      // Ribbon Flag in Center of Rope
      tCtx.fillStyle = "#ef4444";
      tCtx.beginPath();
      tCtx.arc(currentRopeX, ropeY, 5.5, 0, Math.PI * 2);
      tCtx.fill();
      // Ribbon tails
      tCtx.beginPath();
      tCtx.moveTo(currentRopeX - 2, ropeY + 2);
      tCtx.lineTo(currentRopeX - 5, ropeY + 16);
      tCtx.lineTo(currentRopeX, ropeY + 11);
      tCtx.lineTo(currentRopeX + 5, ropeY + 16);
      tCtx.lineTo(currentRopeX + 2, ropeY + 2);
      tCtx.fill();

      // Draw Animals
      drawCuteBear(tCtx, p1AnchorX, groundY - 10, gameState.p1State);
      drawCuteRabbit(tCtx, p2AnchorX, groundY - 10, gameState.p2State);

      // Render Particles
      for (let i = gameState.particles.length - 1; i >= 0; i--) {
        const p = gameState.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= 0.03;
        p.life--;
        tCtx.fillStyle = p.color;
        tCtx.globalAlpha = Math.max(0, p.alpha);
        tCtx.beginPath();
        tCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        tCtx.fill();
        tCtx.globalAlpha = 1;
        if (p.life <= 0 || p.alpha <= 0) {
          gameState.particles.splice(i, 1);
        }
      }

      requestAnimationFrame(renderTugLoop);
    }

    function drawAngleArc(ctx, cx, cy, radius, startAngle, endAngle, color = "#2563eb", fill = "rgba(37, 99, 235, 0.15)") {
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, radius, startAngle, endAngle, false);
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.restore();
    }

    function renderVisual(canvasId, visualData) {
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext('2d');
      resizeCanvas(canvas, ctx);

      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);

      if (!visualData) return;
      const cx = w / 2;
      const cy = h * 0.65;

      switch (visualData.mode) {
        case "angle": {
          const armLen = Math.min(w * 0.35, 65);
          const deg = visualData.deg;
          const rad = (deg * Math.PI) / 180;

          // Vertex
          ctx.beginPath();
          ctx.arc(cx, cy, 4, 0, Math.PI * 2);
          ctx.fillStyle = "#1e293b";
          ctx.fill();

          // Base ray (right)
          ctx.strokeStyle = "#334155";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + armLen, cy);
          ctx.stroke();

          // Terminal Ray
          const endX = cx + Math.cos(-rad) * armLen;
          const endY = cy + Math.sin(-rad) * armLen;
          ctx.strokeStyle = "#e11d48";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(endX, endY);
          ctx.stroke();

          // Marker
          if (deg === 90) {
            ctx.strokeStyle = "#2563eb";
            ctx.lineWidth = 2;
            ctx.strokeRect(cx, cy - 16, 16, 16);
          } else if (deg === 360) {
            ctx.strokeStyle = "#8b5cf6";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(cx, cy, 22, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            drawAngleArc(ctx, cx, cy, 22, -rad, 0, "#0284c7", "rgba(2, 132, 199, 0.2)");
          }

          ctx.font = "bold 12px Fredoka, Arial";
          ctx.fillStyle = "#0f172a";
          ctx.textAlign = "center";
          ctx.fillText(visualData.label || `${deg}°`, cx + (deg > 100 ? -22 : 30), cy - 18);
          break;
        }

        case "protractor": {
          const pRadius = Math.min(w * 0.4, 75);
          const baseCY = h * 0.78;

          // Body
          ctx.beginPath();
          ctx.arc(cx, baseCY, pRadius, Math.PI, 0, false);
          ctx.closePath();
          ctx.fillStyle = "rgba(254, 240, 138, 0.35)";
          ctx.fill();
          ctx.strokeStyle = "#ca8a04";
          ctx.lineWidth = 1.5;
          ctx.stroke();

          // Center cross
          ctx.strokeStyle = "#854d0e";
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(cx - 6, baseCY);
          ctx.lineTo(cx + 6, baseCY);
          ctx.moveTo(cx, baseCY - 6);
          ctx.lineTo(cx, baseCY + 2);
          ctx.stroke();

          // Ticks
          for (let deg = 0; deg <= 180; deg += 10) {
            const rad = (deg * Math.PI) / 180;
            const cos = Math.cos(Math.PI - rad);
            const sin = Math.sin(Math.PI - rad);
            const len = (deg % 30 === 0) ? 9 : 5;

            ctx.strokeStyle = (deg % 30 === 0) ? "#713f12" : "#a16207";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(cx + cos * pRadius, baseCY - sin * pRadius);
            ctx.lineTo(cx + cos * (pRadius - len), baseCY - sin * (pRadius - len));
            ctx.stroke();

            if (deg % 30 === 0 && deg > 0 && deg < 180) {
              ctx.font = "bold 7px Arial";
              ctx.fillStyle = "#b45309";
              ctx.textAlign = "center";
              ctx.textBaseline = "middle";
              ctx.fillText(`${deg}`, cx + cos * (pRadius - 15), baseCY - sin * (pRadius - 15));
            }
          }

          // Labels for baseline 0
          ctx.font = "bold 7px Arial";
          ctx.fillStyle = "#b45309";
          ctx.fillText("0°(外)", cx - pRadius + 12, baseCY - 8);
          ctx.fillStyle = "#0369a1";
          ctx.fillText("0°(內)", cx + pRadius - 12, baseCY - 8);

          // Angle rays
          const targetRad = (visualData.targetDeg * Math.PI) / 180;
          ctx.strokeStyle = "#1e293b";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx, baseCY);
          ctx.lineTo(visualData.side === 'right' ? cx + pRadius + 8 : cx - pRadius - 8, baseCY);
          ctx.stroke();

          const rayAngle = (visualData.side === 'right') ? targetRad : (Math.PI - targetRad);
          ctx.strokeStyle = "#dc2626";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx, baseCY);
          ctx.lineTo(cx + Math.cos(rayAngle) * (pRadius + 8), baseCY - Math.sin(rayAngle) * (pRadius + 8));
          ctx.stroke();
          break;
        }

        case "clock": {
          const r = Math.min(w * 0.28, 45);
          const cCY = h * 0.5;

          ctx.beginPath();
          ctx.arc(cx, cCY, r, 0, Math.PI * 2);
          ctx.fillStyle = "#ffffff";
          ctx.fill();
          ctx.strokeStyle = "#0284c7";
          ctx.lineWidth = 2.5;
          ctx.stroke();

          for (let n = 1; n <= 12; n++) {
            const rad = ((n * 30 - 90) * Math.PI) / 180;
            ctx.font = "bold 9px Arial";
            ctx.fillStyle = "#475569";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(n.toString(), cx + Math.cos(rad) * (r - 9), cCY + Math.sin(rad) * (r - 9));
          }

          const minAngle = ((visualData.minute * 6 - 90) * Math.PI) / 180;
          const hrAngle = ((((visualData.hour % 12) * 30 + visualData.minute * 0.5) - 90) * Math.PI) / 180;

          // Minute Hand
          ctx.strokeStyle = "#2563eb";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(cx, cCY);
          ctx.lineTo(cx + Math.cos(minAngle) * (r - 12), cCY + Math.sin(minAngle) * (r - 12));
          ctx.stroke();

          // Hour Hand
          ctx.strokeStyle = "#e11d48";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(cx, cCY);
          ctx.lineTo(cx + Math.cos(hrAngle) * (r - 20), cCY + Math.sin(hrAngle) * (r - 20));
          ctx.stroke();
          break;
        }

        case "clockSpan": {
          const r = Math.min(w * 0.28, 45);
          const cCY = h * 0.5;

          ctx.beginPath();
          ctx.arc(cx, cCY, r, 0, Math.PI * 2);
          ctx.fillStyle = "#f8fafc";
          ctx.fill();
          ctx.strokeStyle = "#64748b";
          ctx.lineWidth = 2;
          ctx.stroke();

          const sRad = ((visualData.start * 30 - 90) * Math.PI) / 180;
          const eRad = ((visualData.end * 30 - 90) * Math.PI) / 180;

          ctx.beginPath();
          ctx.moveTo(cx, cCY);
          ctx.arc(cx, cCY, r - 2, sRad, eRad, false);
          ctx.closePath();
          ctx.fillStyle = "rgba(245, 158, 11, 0.3)";
          ctx.fill();
          break;
        }

        case "combine": {
          const arm = 60;
          const aDeg = visualData.a;
          const totDeg = aDeg + visualData.b;

          ctx.strokeStyle = "#334155";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + arm, cy);
          ctx.stroke();

          const midRad = -(aDeg * Math.PI) / 180;
          ctx.strokeStyle = "#0284c7";
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(midRad) * arm, cy + Math.sin(midRad) * arm);
          ctx.stroke();

          const totRad = -(totDeg * Math.PI) / 180;
          ctx.strokeStyle = "#e11d48";
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(totRad) * arm, cy + Math.sin(totRad) * arm);
          ctx.stroke();

          ctx.font = "bold 10px Arial";
          ctx.fillStyle = "#0284c7";
          ctx.fillText(`${visualData.a}°`, cx + 32, cy - 8);
          ctx.fillStyle = "#e11d48";
          ctx.fillText(`${visualData.b}°`, cx + 18, cy - 28);
          break;
        }

        case "straightDiff": {
          const arm = 60;
          const cutRad = -(visualData.cut * Math.PI) / 180;

          ctx.strokeStyle = "#334155";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx - arm, cy);
          ctx.lineTo(cx + arm, cy);
          ctx.stroke();

          ctx.strokeStyle = "#ef4444";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(cutRad) * arm, cy + Math.sin(cutRad) * arm);
          ctx.stroke();

          ctx.font = "bold 10px Arial";
          ctx.fillStyle = "#ef4444";
          ctx.fillText(`${visualData.cut}°`, cx + 28, cy - 10);
          ctx.fillStyle = "#2563eb";
          ctx.fillText("?°", cx - 26, cy - 16);
          break;
        }

        case "triangles": {
          const len = 65;
          const rA = (visualData.a * Math.PI) / 180;
          const rTot = ((visualData.a + visualData.b) * Math.PI) / 180;

          ctx.strokeStyle = "#475569";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + len, cy);
          ctx.stroke();

          ctx.strokeStyle = "#2563eb";
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(-rA) * len, cy + Math.sin(-rA) * len);
          ctx.stroke();

          ctx.strokeStyle = "#f97316";
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(-rTot) * len, cy + Math.sin(-rTot) * len);
          ctx.stroke();

          ctx.font = "bold 10px Arial";
          ctx.fillStyle = "#1d4ed8";
          ctx.fillText(`${visualData.a}°`, cx + 38, cy - 8);
          ctx.fillStyle = "#c2410c";
          ctx.fillText(`${visualData.b}°`, cx + 18, cy - 30);
          break;
        }

        case "perigonDiff": {
          const r = 35;
          const pRad = (visualData.part * Math.PI) / 180;

          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.arc(cx, cy, r, 0, pRad, false);
          ctx.closePath();
          ctx.fillStyle = "rgba(147, 51, 234, 0.25)";
          ctx.fill();
          ctx.strokeStyle = "#9333ea";
          ctx.lineWidth = 2;
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.arc(cx, cy, r + 6, pRad, Math.PI * 2, false);
          ctx.closePath();
          ctx.fillStyle = "rgba(245, 158, 11, 0.25)";
          ctx.fill();
          ctx.strokeStyle = "#f59e0b";
          ctx.lineWidth = 2;
          ctx.stroke();
          break;
        }
      }
    }

    function renderQuestion(pNum) {
      const isP1 = pNum === 1;
      const idx = isP1 ? gameState.p1Index : gameState.p2Index;
      const qList = isP1 ? PLAYER1_QUESTIONS : PLAYER2_QUESTIONS;
      const q = qList[idx];
      const pfx = isP1 ? "p1" : "p2";

      // Update Texts & Tags
      document.getElementById(`${pfx}LevelTag`).innerText = q.level;
      document.getElementById(`${pfx}ScoreStatus`).innerText = `得分: ${isP1 ? gameState.p1Score : gameState.p2Score} 分 (第 ${idx + 1}/${qList.length} 題)`;
      document.getElementById(`${pfx}ProgressBar`).style.width = `${((idx + 1) / qList.length) * 100}%`;
      document.getElementById(`${pfx}QuestionText`).innerText = q.text;

      // Draw Visual
      renderVisual(`${pfx}VisCanvas`, q.visual);

      // Hide Feedback
      document.getElementById(`${pfx}FeedbackBox`).classList.add('hidden');

      // Build Option Buttons
      const grid = document.getElementById(`${pfx}OptionsGrid`);
      grid.innerHTML = "";

      const btnBg = isP1
        ? "bg-blue-50/90 border-blue-200 active:bg-blue-200 text-blue-950"
        : "bg-rose-50/90 border-rose-200 active:bg-rose-200 text-rose-950";

      q.options.forEach((optText, i) => {
        const btn = document.createElement('button');
        btn.className = `w-full py-2 px-2.5 rounded-xl border-2 font-black text-xs sm:text-sm tracking-wide text-center transition-transform active:scale-95 shadow-xs flex items-center justify-center gap-1 ${btnBg}`;
        btn.innerHTML = `<span class="inline-block w-4 h-4 rounded-full bg-white border border-slate-300 text-[10px] text-slate-700 leading-none pt-0.5">${['A','B','C','D'][i]}</span> ${optText}`;

        btn.onclick = () => handleChoice(pNum, i, btn);
        grid.appendChild(btn);
      });

      if (isP1) gameState.p1Locked = false;
      else gameState.p2Locked = false;
    }

    function handleChoice(pNum, chosenIdx, btnElem) {
      const isP1 = pNum === 1;
      if (isP1 && gameState.p1Locked) return;
      if (!isP1 && gameState.p2Locked) return;

      if (isP1) gameState.p1Locked = true;
      else gameState.p2Locked = true;

      const idx = isP1 ? gameState.p1Index : gameState.p2Index;
      const qList = isP1 ? PLAYER1_QUESTIONS : PLAYER2_QUESTIONS;
      const q = qList[idx];
      const isRight = (chosenIdx === q.ans);
      const pfx = isP1 ? "p1" : "p2";

      const fbBox = document.getElementById(`${pfx}FeedbackBox`);
      const fbText = document.getElementById(`${pfx}FeedbackText`);
      const optionsBox = document.getElementById(`${pfx}OptionsGrid`);
      const buttons = optionsBox.querySelectorAll('button');
      buttons.forEach(b => b.classList.add('pointer-events-none'));

      // Center Tug Animation and Particles
      const tugRect = tugCanvas.getBoundingClientRect();
      const tugCenterCanvasX = tugCanvas.clientWidth / 2;

      if (isRight) {
        soundRight();
        soundPull();
        btnElem.classList.remove('bg-blue-50/90', 'bg-rose-50/90');
        btnElem.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600');

        if (isP1) {
          gameState.p1Score += 1;
          gameState.targetRope -= 24; // Pull to Bear (Left)
          gameState.p1State = 'pull';
          gameState.p2State = 'sweat';
          addParticles(tugCenterCanvasX - 30, 25, '#3b82f6');
        } else {
          gameState.p2Score += 1;
          gameState.targetRope += 24; // Pull to Rabbit (Right)
          gameState.p2State = 'pull';
          gameState.p1State = 'sweat';
          addParticles(tugCenterCanvasX + 30, 25, '#f43f5e');
        }

        fbBox.className = "mt-1 p-1.5 rounded-xl bg-emerald-50 border border-emerald-300 text-[11px] block";
        fbText.innerHTML = `<span class="font-extrabold text-emerald-800">答對了！</span> ${q.exp}`;
      } else {
        soundWrong();
        btnElem.classList.add('bg-red-500', 'text-white', 'border-red-600');
        if (buttons[q.ans]) {
          buttons[q.ans].classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-800');
        }

        if (isP1) gameState.p1State = 'sweat';
        else gameState.p2State = 'sweat';

        fbBox.className = "mt-1 p-1.5 rounded-xl bg-rose-50 border border-rose-300 text-[11px] block";
        fbText.innerHTML = `<span class="font-extrabold text-rose-800">答錯了！</span> ${q.exp}`;
      }

      // Update Top tug prompt
      const prompt = document.getElementById('tugCenterPrompt');
      if (gameState.targetRope < -20) {
        prompt.innerText = "🐻 藍隊小熊發力領先！";
      } else if (gameState.targetRope > 20) {
        prompt.innerText = "🐰 紅隊兔子強勢拉回！";
      }

      // Wait and advance
      setTimeout(() => {
        gameState.p1State = 'idle';
        gameState.p2State = 'idle';

        if (isP1) {
          gameState.p1Index++;
          if (gameState.p1Index < qList.length) {
            renderQuestion(1);
          } else {
            checkGameOver();
          }
        } else {
          gameState.p2Index++;
          if (gameState.p2Index < qList.length) {
            renderQuestion(2);
          } else {
            checkGameOver();
          }
        }
      }, 1800);
    }

    function checkGameOver() {
      const bothDone = (gameState.p1Index >= 10 && gameState.p2Index >= 10);
      const blueLimit = gameState.targetRope <= -85;
      const redLimit = gameState.targetRope >= 85;

      if (bothDone || blueLimit || redLimit) {
        if (gameState.isOver) return;
        gameState.isOver = true;
        soundWin();

        const modal = document.getElementById('gameOverModal');
        const winnerTitle = document.getElementById('winnerText');
        const winnerSub = document.getElementById('winnerSubText');
        const trophy = document.getElementById('trophyIcon');

        document.getElementById('finalP1Score').innerText = `${gameState.p1Score} / 10 題答對`;
        document.getElementById('finalP2Score').innerText = `${gameState.p2Score} / 10 題答對`;

        if (gameState.p1Score > gameState.p2Score || blueLimit) {
          trophy.innerText = "🐻👑";
          winnerTitle.innerHTML = `<span class="text-blue-600">元氣小熊隊</span> 拔河大勝利！`;
          winnerSub.innerText = "小熊隊完美掌握量角器與角度，成功將繩子拉過分水嶺！";
        } else if (gameState.p2Score > gameState.p1Score || redLimit) {
          trophy.innerText = "🐰👑";
          winnerTitle.innerHTML = `<span class="text-rose-600">活力兔子隊</span> 拔河大勝利！`;
          winnerSub.innerText = "兔子隊反應敏捷、算度精準，勇奪拔河冠軍獎盃！";
        } else {
          trophy.innerText = "🤝";
          winnerTitle.innerText = "平分秋色！雙方握手言和！";
          winnerSub.innerText = "兩位都是四年級幾何角度小高手！";
        }

        modal.classList.remove('hidden');
      }
    }

    function resetGame() {
      gameState.p1Index = 0;
      gameState.p2Index = 0;
      gameState.p1Score = 0;
      gameState.p2Score = 0;
      gameState.p1Locked = false;
      gameState.p2Locked = false;
      gameState.ropePos = 0;
      gameState.targetRope = 0;
      gameState.isOver = false;
      gameState.p1State = 'idle';
      gameState.p2State = 'idle';

      document.getElementById('gameOverModal').classList.add('hidden');
      document.getElementById('tugCenterPrompt').innerText = "拔河對決中！答對拉向自己！";

      renderQuestion(1);
      renderQuestion(2);
    }

    const layoutToggleBtn = document.getElementById('layoutToggleBtn');
    const layoutIcon = document.getElementById('layoutIcon');
    const layoutLabel = document.getElementById('layoutLabel');
    const p2Section = document.getElementById('p2Section');
    const mainContainer = document.getElementById('gameMainContainer');

    layoutToggleBtn.addEventListener('click', () => {
      isFaceToFace = !isFaceToFace;
      if (isFaceToFace) {
        // Face-to-Face Mode (Top player flipped 180 degrees)
        p2Section.classList.add('face-opposite');
        mainContainer.classList.remove('sm:flex-row');
        mainContainer.classList.add('flex-col');
        layoutIcon.className = "fa-solid fa-arrows-up-down text-indigo-600";
        layoutLabel.innerText = "面對面(180°)";
      } else {
        // Side-by-Side Mode (Both upright)
        p2Section.classList.remove('face-opposite');
        layoutIcon.className = "fa-solid fa-table-columns text-indigo-600";
        layoutLabel.innerText = "並排坐模式";
      }
      // Redraw visuals after transition
      setTimeout(() => {
        renderVisual('p1VisCanvas', PLAYER1_QUESTIONS[gameState.p1Index].visual);
        renderVisual('p2VisCanvas', PLAYER2_QUESTIONS[gameState.p2Index].visual);
      }, 50);
    });

    // Fullscreen Toggle
    document.getElementById('fullscreenBtn').addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
      }
    });

    // Sound Toggle
    document.getElementById('soundToggleBtn').addEventListener('click', () => {
      initAudio();
      isSoundOn = !isSoundOn;
      const icon = document.getElementById('soundIcon');
      if (isSoundOn) {
        icon.className = "fa-solid fa-volume-high text-amber-700";
      } else {
        icon.className = "fa-solid fa-volume-xmark text-slate-400";
      }
    });

    document.getElementById('resetGameBtn').addEventListener('click', resetGame);
    document.getElementById('modalRestartBtn').addEventListener('click', resetGame);

    window.addEventListener('resize', () => {
      resizeCanvas(tugCanvas, tCtx);
      renderVisual('p1VisCanvas', PLAYER1_QUESTIONS[gameState.p1Index]?.visual);
      renderVisual('p2VisCanvas', PLAYER2_QUESTIONS[gameState.p2Index]?.visual);
    });

    // Start application
    window.onload = function () {
      resizeCanvas(tugCanvas, tCtx);
      renderQuestion(1);
      renderQuestion(2);
      renderTugLoop();
    };
  </script>
</body>
</html>
